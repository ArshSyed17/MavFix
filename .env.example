# ─────────────────────────────────────────────────────────────────
#  MavFix Genesis — Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── LLM ──────────────────────────────────────────────────────────
# Google Gemini API Key (e.g. from Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key-here
MAVFIX_GEMINI_MODEL=gemini-flash-lite-latest

# Anthropic Claude API Key (optional)
ANTHROPIC_API_KEY=sk-ant-your-key-here
MAVFIX_LLM_MODEL=claude-3-5-haiku-20241022
MAVFIX_LLM_MAX_TOKENS=1024

# ── Remediation Mode ─────────────────────────────────────────────
# Set to "true" to enable real subprocess/Docker execution.
# "false" = fully simulated (safe for demos, default).
MAVFIX_LIVE_MODE=false

# ── Database ─────────────────────────────────────────────────────
# Path to the SQLite audit database (relative to project root)
MAVFIX_DB_PATH=audit_logs/mavfix.db

# ── Simulator ────────────────────────────────────────────────────
# Seconds between ambient (background noise) alert ticks
MAVFIX_AMBIENT_INTERVAL_SEC=8

# ── Incident Clustering ──────────────────────────────────────────
# Time window (seconds) within which alerts are considered for clustering
MAVFIX_CLUSTER_WINDOW_SEC=300

# Minimum alerts required to form a named incident
MAVFIX_CLUSTER_MIN_ALERTS=2

# Cosine-similarity threshold for message-based grouping (0.0–1.0)
MAVFIX_CLUSTER_SIMILARITY_THRESHOLD=0.35

# ── UI ───────────────────────────────────────────────────────────
# Live feed refresh interval (seconds)
MAVFIX_UI_REFRESH_SEC=3
